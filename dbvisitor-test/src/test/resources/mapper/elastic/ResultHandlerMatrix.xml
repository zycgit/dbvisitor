<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//dbvisitor.net//DTD Mapper 1.0//EN"
        "https://www.dbvisitor.net/schema/dbvisitor-mapper.dtd">
<mapper namespace="xmltest.ResultHandlerMapper">
    <resultMap id="userResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="email" property="email"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <sql id="query">
        @{macro, esXmlPath}/_search {"_source": ["id","name","age","email","create_time"],"size": 100,"sort": [{"id": "asc"}]
        <if test="minAge != null">,"query": {"range": {"age": {"gt": #{minAge}}}}</if>}
    </sql>
    <select id="selectByResultType" resultType="net.hasor.dbvisitor.test.contract.material.model.UserInfo"><include refid="query"/></select>
    <select id="selectByResultTypeMap" resultType="map"><include refid="query"/></select>
    <select id="countByResultType" resultType="int">@{macro, esXmlPath}/_count</select>
    <select id="countByResultTypeLong" resultType="long">@{macro, esXmlPath}/_count</select>
    <select id="selectNamesByResultType" resultType="string">
        @{macro, esXmlPath}/_search {"_source": ["name"],"size": 100,"sort": [{"id": "asc"}]}
    </select>
    <select id="selectByResultMap" resultMap="userResultMap"><include refid="query"/></select>
    <select id="selectByColumnMapRowMapper" resultRowMapper="net.hasor.dbvisitor.test.contract.material.handler.ResultHandlerProbe$ColumnMapMapper">
        <include refid="query"/>
    </select>

    <select id="selectByRowCallback" resultRowCallback="net.hasor.dbvisitor.test.contract.api.mapper.xml.XmlMapperResultHandlerCase$CountingCallback">
        <include refid="query"/>
    </select>
    <select id="selectByColumnMapExtractor" resultSetExtractor="net.hasor.dbvisitor.test.contract.material.handler.ResultHandlerProbe$ColumnMapExtractor">
        <include refid="query"/>
    </select>
    <select id="selectIdNamePairs" resultSetExtractor="net.hasor.dbvisitor.jdbc.extractor.PairsResultSetExtractor">
        @{macro, esXmlPath}/_search {"_source": ["id","name"],"size": 100,"sort": [{"id": "asc"}]}
    </select>
</mapper>
