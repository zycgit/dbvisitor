<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//dbvisitor.net//DTD Mapper 1.0//EN"
        "https://www.dbvisitor.net/schema/dbvisitor-mapper.dtd">
<mapper namespace="net.hasor.dbvisitor.test.realdb.elastic7.Elastic7SessionMapperFixture$NativeRefDao">
    <resultMap id="userResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo">
        <result column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="email" property="email"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <insert id="insertUser">@{macro, esSessionInsert}</insert>
    <select id="selectById" resultMap="userResultMap">@{macro, esSessionOne}</select>
    <select id="selectAll" resultMap="userResultMap">@{macro, esSessionAll}</select>
    <update id="updateEmail">@{macro, esSessionEmail}</update>
    <delete id="deleteById">@{macro, esSessionDelete}</delete>
    <select id="selectByCondition" resultMap="userResultMap">
        POST /@{macro,esSessionIndex}/_search {"size": 100,"query": {"bool": {"filter": [{"match_all": {}}
        <if test="name != null">,{"wildcard": {"name": #{name.replace('%', '*')}}}</if>
        <if test="minAge != null">,{"range": {"age": {"gte": #{minAge}}}}</if>
        ]}},"sort": [{"id": "asc"}]}
    </select>
    <select id="selectByIds" resultMap="userResultMap">
        POST /@{macro,esSessionIndex}/_search {"size": 100,"query": {"terms": {"id": [
        <foreach collection="ids" item="id" separator=",">#{id}</foreach>
        ]}},"sort": [{"id": "asc"}]}
    </select>
    <select id="selectByAgeRange" resultMap="userResultMap">
        POST /@{macro,esSessionIndex}/_search {"size": 100,"query": {"range": {"age": {"gte": #{range.minAge},"lte": #{range.maxAge}}}},"sort": [{"id": "asc"}]}
    </select>
    <select id="selectByBean" resultMap="userResultMap">
        POST /@{macro,esSessionIndex}/_search {"size": 100,"query": {"bool": {"filter": [
        {"range": {"name": {"gte": #{user.name}}}},{"range": {"age": {"gte": #{user.age}}}}
        ]}},"sort": [{"id": "asc"}]}
    </select>
    <select id="selectWithOrderBy" resultMap="userResultMap">
        POST /@{macro,esSessionIndex}/_search {"size": 100,"sort": [{${orderColumn}: "asc"}]}
    </select>
    <select id="selectAsMaps" resultType="map">
        POST /@{macro,esSessionIndex}/_search {"_source": ["id","name","age","email","create_time"],"size": 100,"sort": [{"id": "asc"}]}
    </select>
    <select id="selectAgeStats" resultType="map">
        POST /@{macro,esSessionIndex}/_search {"size": 0,"aggs": {"by_age": {"terms": {"field": "age"}}}}
    </select>
</mapper>
