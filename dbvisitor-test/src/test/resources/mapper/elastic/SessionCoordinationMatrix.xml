<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//dbvisitor.net//DTD Mapper 1.0//EN" "https://www.dbvisitor.net/schema/dbvisitor-mapper.dtd">
<mapper namespace="session.UserSessionMapper">
    <insert id="insertUser">@{macro, esSessionInsert}</insert>
    <insert id="insertOrder">
        @{macro, esOrderPath}/_doc?refresh=true
        {"id": #{id},"user_id": #{userId},"order_no": #{orderNo},"amount": #{amount}}
    </insert>
    <select id="queryOrdersByUserId" resultType="net.hasor.dbvisitor.test.contract.material.model.UserOrder">
        @{macro, esOrderPath}/_search {"query": {"term": {"user_id": #{userId}}},"sort": [{"id": "asc"}]}
    </select>
    <delete id="deleteOrderById">
        @{macro, esOrderPath}/_delete_by_query?refresh=true {"query": {"term": {"id": #{id}}}}
    </delete>
</mapper>
