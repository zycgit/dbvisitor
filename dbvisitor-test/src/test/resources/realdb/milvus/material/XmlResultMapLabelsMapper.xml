<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//dbvisitor.net//DTD Mapper 1.0//EN"
        "https://www.dbvisitor.net/schema/dbvisitor-mapper.dtd">
<mapper namespace="milvus.ResultMapLabels">
    <select id="selectLabels" resultType="map">
        SELECT user_id, user_name, user_age FROM result_map_labels WHERE user_id = #{id}
    </select>
</mapper>
