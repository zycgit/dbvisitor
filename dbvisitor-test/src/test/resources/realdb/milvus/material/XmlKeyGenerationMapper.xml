<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//dbvisitor.net//DTD Mapper 1.0//EN"
        "https://www.dbvisitor.net/schema/dbvisitor-mapper.dtd">
<mapper namespace="xmltest.KeyGenerationMapper">
    <insert id="insertWithGeneratedKeys" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_info (name, age, email)
        VALUES (#{name}, #{age}, #{email})
    </insert>

    <insert id="insertWithExplicitId">
        INSERT INTO user_info (id, name, age, email)
        VALUES (#{id}, #{name}, #{age}, #{email})
    </insert>

    <!-- The key remains Int64 in the parameter Map; this query verifies the row it identifies. -->
    <select id="selectById" resultType="net.hasor.dbvisitor.test.contract.material.model.UserInfo">
        SELECT name, age, email FROM user_info WHERE id = #{id}
    </select>
</mapper>
