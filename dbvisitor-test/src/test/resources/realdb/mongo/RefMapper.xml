<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//dbvisitor.net//DTD Mapper 1.0//EN"
        "https://www.dbvisitor.net/schema/dbvisitor-mapper.dtd">
<mapper namespace="net.hasor.dbvisitor.test.realdb.mongo.material.MongoRefMapper">

    <resultMap id="userResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="email" property="email"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <insert id="insertUser">
        @{macro, mongoSource}.insert({id: #{id}, name: #{name}, age: #{age}, email: #{email}, create_time: #{createTime}})
    </insert>

    <select id="selectById" resultMap="userResultMap">
        @{macro, mongoSource}.find({id: #{id}}, {_id: 0})
    </select>

    <select id="selectAll" resultMap="userResultMap">
        @{macro, mongoSource}.find({name: {$regex: '^RefMap'}}, {_id: 0}).sort({id: 1})
    </select>

    <update id="updateEmail">
        @{macro, mongoSource}.update({id: #{id}}, {$set: {email: #{email}}})
    </update>

    <delete id="deleteById">
        @{macro, mongoSource}.remove({id: #{id}})
    </delete>
    <select id="selectByCondition" resultMap="userResultMap">
        @{macro, mongoSource}.find({
            <trim suffixOverrides=",">
                <if test="name != null">
                    $expr: {$regexMatch: {input: '$name', regex: {$replaceAll: {input: #{name}, find: '%', replacement: '.*'}}}},
                </if>
                <if test="minAge != null">age: {$gte: #{minAge}},</if>
            </trim>
        }, {_id: 0}).sort({id: 1})
    </select>
    <select id="selectByIds" resultMap="userResultMap">
        @{macro, mongoSource}.find({id: {$in: <foreach collection="ids" item="id" open="[" separator="," close="]">#{id}</foreach>}}, {_id: 0}).sort({id: 1})
    </select>
    <select id="selectByAgeRange" resultMap="userResultMap">
        @{macro, mongoSource}.find({age: {$gte: #{range.minAge}, $lte: #{range.maxAge}}}, {_id: 0}).sort({id: 1})
    </select>
    <select id="selectByBean" resultMap="userResultMap">
        @{macro, mongoSource}.find({name: {$gte: #{user.name}}, age: {$gte: #{user.age}}}, {_id: 0}).sort({id: 1})
    </select>
    <select id="selectWithOrderBy" resultMap="userResultMap">
        @{macro, mongoSource}.find({name: {$regex: '^RefMap'}}, {_id: 0}).sort(${orderColumn})
    </select>

    <select id="selectAsMaps" resultType="map">
        @{macro, mongoSource}.find({name: {$regex: '^RefMap'}}, {_id: 0}).sort({id: 1})
    </select>
    <select id="selectAgeStats" resultType="map">
        @{macro, mongoSource}.aggregate([{$match: {name: {$regex: '^RefMap'}}}, {$group: {_id: '$age', cnt: {$sum: 1}}}, {$project: {_id: 0, age: '$_id', cnt: 1}}, {$sort: {age: 1}}])
    </select>

</mapper>
