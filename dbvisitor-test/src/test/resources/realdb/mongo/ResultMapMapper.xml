<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//dbvisitor.net//DTD Mapper 1.0//EN"
        "https://www.dbvisitor.net/schema/dbvisitor-mapper.dtd">
<mapper namespace="xmltest.ResultMapMapper">
    <resultMap id="baseResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
    </resultMap>
    <resultMap id="extendedResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="email" property="email"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <resultMap id="typedResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo">
        <id column="id" property="id" javaType="java.lang.Integer"/>
        <result column="name" property="name" javaType="java.lang.String"/>
        <result column="age" property="age" javaType="java.lang.Integer"/>
        <result column="email" property="email" javaType="java.lang.String"/>
        <result column="create_time" property="createTime" javaType="java.util.Date"/>
    </resultMap>
    <resultMap id="autoMappingResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo" autoMapping="true">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="email" property="email"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <resultMap id="caseInsensitiveResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo" caseInsensitive="true">
        <id column="ID" property="id"/>
        <result column="NAME" property="name"/>
        <result column="AGE" property="age"/>
        <result column="EMAIL" property="email"/>
    </resultMap>
    <resultMap id="camelCaseResultMap" type="net.hasor.dbvisitor.test.contract.material.model.UserInfo" mapUnderscoreToCamelCase="true">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="email" property="email"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <insert id="insertUser">
        @{macro, mongoSource}.insert({id: #{id}, name: #{name}, age: #{age}, email: #{email}})
    </insert>
    <select id="selectByIdBase" resultMap="baseResultMap">
        @{macro, mongoSource}.find({id: #{id}}, {_id: 0})
    </select>
    <select id="selectByIdExtended" resultMap="extendedResultMap">
        @{macro, mongoSource}.find({id: #{id}}, {_id: 0})
    </select>
    <select id="selectByIdTyped" resultMap="typedResultMap">
        @{macro, mongoSource}.find({id: #{id}}, {_id: 0})
    </select>
    <select id="selectByIdAutoMapping" resultMap="autoMappingResultMap">
        @{macro, mongoSource}.find({id: #{id}}, {_id: 0})
    </select>
    <select id="selectByIdCaseInsensitive" resultMap="caseInsensitiveResultMap">
        @{macro, mongoSource}.find({id: #{id}}, {_id: 0})
    </select>
    <select id="selectByIdCamelCase" resultMap="camelCaseResultMap">
        @{macro, mongoSource}.find({id: #{id}}, {_id: 0})
    </select>
    <select id="selectByIdAsRenamedMap" resultType="map">
        @{macro, mongoSource}.aggregate([{$match: {id: #{id}}}, {$project: {_id: 0, user_id: '$id', user_name: '$name', user_age: '$age'}}])
    </select>
    <select id="selectAllBase" resultMap="baseResultMap">
        @{macro, mongoSource}.find({id: {$gte: #{firstId}, $lte: #{lastId}}}, {_id: 0})
    </select>

</mapper>

