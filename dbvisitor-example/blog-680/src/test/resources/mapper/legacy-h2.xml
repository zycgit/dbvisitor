<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//dbvisitor.net//DTD Mapper 1.0//EN" "https://www.dbvisitor.net/schema/dbvisitor-mapper.dtd">
<mapper namespace="example.LegacyArticleExamplesTest$Users">
    <resultMap id="userResultMap" type="example.LegacyArticleExamplesTest$UserInfo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="age" property="age"/>
        <result column="status" property="status"/>
    </resultMap>
    <select id="page" resultMap="userResultMap">
        SELECT * FROM user_info ORDER BY id
    </select>
</mapper>
